// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
   binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
  role     Role   @default(CLIENT)
  sessions Session[]
  loginOtps LoginOtp[]

  // Google Calendar integration
  googleAccessToken   String?   @db.Text
  googleRefreshToken  String?   @db.Text
  googleTokenExpiry   DateTime?

  admin         Admin?
  client        Client?
  staff         Staff?
  bookings      Booking[]
  notifications Notification[]
}

enum Role {
  ADMIN
  STAFF
  CLIENT
}

model Admin {
  id          Int    @id @default(autoincrement())
  userId      Int    @unique
  permissions Json?
  department  String?

  user        User   @relation(fields: [userId], references: [id])
}

model Client {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  bookings     Booking[]
  reviews      Review[]
  forms        Form[]
  waitlists    Waitlist[]
  intakeForms IntakeForm[]
  consentForms ConsentForm[]
}
model IntakeForm {
  id        Int      @id @default(autoincrement())
  clientId  Int
  client    Client   @relation(fields: [clientId], references: [id])
  hairType  String?
  scalpCondition String?
  productPreference String?
  visitReason String?
  lastChemicalTreatment String?
  currentProducts String?
  goals     String?
  allergies String?
  notes     String?
  createdAt DateTime @default(now())
}

model ConsentForm {
  id        Int      @id @default(autoincrement())
  clientId  Int
  client    Client   @relation(fields: [clientId], references: [id])
  consentGiven Boolean
  signature  String?
  date       DateTime @default(now())
}

model Staff {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique
  bio         String?
  createdAt   DateTime  @default(now())

  user         User         @relation(fields: [userId], references: [id])
  appointments Appointment[]
  reviews      Review[]
}

model Appointment {
  id        Int               @id @default(autoincrement())
  serviceId Int
  staffId   Int?
  date      DateTime
  status    AppointmentStatus @default(PENDING)
  notes     String?

  reminderScheduled Boolean   @default(false)
  reminderSent      Boolean   @default(false)
  reminderSentAt    DateTime?
  reminderCron      String?
  reminderActive    Boolean   @default(false)

  googleEventId     String?

  service Service  @relation(fields: [serviceId], references: [id])
  staff   Staff?   @relation(fields: [staffId], references: [id])
  booking Booking?
  slots   Slot[]

  @@index([serviceId])
  @@index([staffId])
}


enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
  NO_SHOW
  WAITLISTED
}

model Slot {
  id            Int      @id @default(autoincrement())
  appointmentId Int
  startTime     DateTime
  endTime       DateTime
  isBooked      Boolean  @default(false)

  appointment   Appointment @relation(fields: [appointmentId], references: [id])
}

model Booking {
  id            Int           @id @default(autoincrement())
  appointmentId Int           @unique
  clientId      Int
  userId        Int?
  promocodeId   Int?
  status        BookingStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  client      Client      @relation(fields: [clientId], references: [id])
  user        User?       @relation(fields: [userId], references: [id])
  promocode   Promocode?  @relation(fields: [promocodeId], references: [id])
  payment     Payment?
  form        Form?

  @@index([clientId])
  @@index([userId])
  @@index([promocodeId])
}


enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Form {
  id             Int      @id @default(autoincrement())
  clientId       Int
  bookingId      Int?     @unique
  title          String
  fields         Json // flexible storage: for a formTemplateId submission, answers keyed by FormField.id (as a string)
  formTemplateId Int? // set when this Form is a submission of an admin-defined FormTemplate (e.g. a service-category consultation form)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client       Client        @relation(fields: [clientId], references: [id])
  booking      Booking?      @relation(fields: [bookingId], references: [id])
  formTemplate FormTemplate? @relation(fields: [formTemplateId], references: [id])

  @@index([formTemplateId])
}

model Payment {
  id             Int               @id @default(autoincrement())
  bookingId      Int               @unique
  amount         Float
  currency       String            @default("GHS") // store currency explicitly
  method         PaymentMethod
  provider       PaymentProvider
  status         PaymentStatus     @default(PENDING)
  transactionRef String?           // gateway reference (Paystack ref, MoMo txn ID, etc.)
  externalId     String?           // unique ID returned by provider
  metadata       Json?             // flexible storage for provider-specific data
  errorMessage   String?           // capture failure reason
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  booking        Booking           @relation(fields: [bookingId], references: [id])
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
}

enum PaymentProvider {
  PAYSTACK
  CASH
  MOBILE_MONEY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUND_PENDING // was SUCCESS, booking got cancelled — needs admin to process a refund
  REFUNDED
}

model Review {
  id        Int      @id @default(autoincrement())
  clientId  Int
  serviceId Int?
  staffId   Int?
  rating    Int // e.g., 1–5 stars
  comment   String?
  createdAt DateTime @default(now())

  client  Client   @relation(fields: [clientId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id])
  staff   Staff?   @relation(fields: [staffId], references: [id])
}

model Promocode {
  id          Int          @id @default(autoincrement())
  code        String       @unique
  description String?
  discount    Float // percentage or fixed amount
  type        DiscountType
  validFrom   DateTime
  validUntil  DateTime
  isActive    Boolean      @default(true)

  bookings Booking[]
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Service {
  id          Int      @id @default(autoincrement())
  categoryId  Int
  name        String    
  description String?
  duration    Int 
  price       Float
  isActive    Boolean  @default(true)
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category     ServiceCategory @relation(fields: [categoryId], references: [id])
  appointments Appointment[]
  reviews      Review[]
  waitlists    Waitlist[]    @relation("ServiceWaitlist")

  @@index([categoryId])
}

// A booking-page category such as "Locs Styling", "Retie Services", or
// "Starter Locs" — each groups a set of concrete, chargeable Services
// (the "sub-options" a client actually picks and pays for). Fully
// admin-managed: name, description, ordering, and active state are all
// editable via the admin dashboard, and services can be moved between
// categories without losing their appointment/booking history.
model ServiceCategory {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  slug           String   @unique
  description    String?
  displayOrder   Int      @default(0)
  isActive       Boolean  @default(true)
  // Optional consultation/intake form (e.g. SCALP-FIRST) a client must
  // complete before booking ANY service in this category. Null means no
  // form is required. Admin-assignable independently of the form's own
  // content, so the same template could later be reused across categories.
  formTemplateId Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  formTemplate FormTemplate? @relation(fields: [formTemplateId], references: [id])
  services     Service[]

  @@index([formTemplateId])
}

// Admin-authored, fully customizable form definition — the "form builder"
// behind a category's required consultation (e.g. SCALP-FIRST). Its
// questions live in FormField, editable/reorderable independently of the
// template itself, so admin changes here never require a deploy.
model FormTemplate {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fields      FormField[]
  categories  ServiceCategory[]
  submissions Form[]
}

// A single admin-editable question on a FormTemplate. `order` drives
// display order within the template (and, when `section` is set, within
// that section) so admin can freely reorder without touching code.
model FormField {
  id             Int           @id @default(autoincrement())
  formTemplateId Int
  section        String? // optional grouping heading, e.g. "Scalp Tolerance"
  label          String
  helpText       String?
  fieldType      FormFieldType
  options        Json? // choice labels for SINGLE_SELECT / MULTI_SELECT
  required       Boolean       @default(false)
  order          Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  formTemplate FormTemplate @relation(fields: [formTemplateId], references: [id], onDelete: Cascade)

  @@index([formTemplateId, order])
}

enum FormFieldType {
  TEXT
  TEXTAREA
  SINGLE_SELECT
  MULTI_SELECT
  SCALE
  DATE
  CHECKBOX
  SIGNATURE
}

model Settings {
  id          Int      @id @default(autoincrement())
  key         String   @unique // e.g., "working_hours", "cancellation_policy"
  value       Json // flexible storage for different types of settings
  description String?
  updatedAt   DateTime @updatedAt
}

model Waitlist {
  id            Int            @id @default(autoincrement())
  clientId      Int
  serviceId     Int?
  preferredDate DateTime?
  status        WaitlistStatus @default(PENDING)
  createdAt     DateTime       @default(now())

  client  Client   @relation(fields: [clientId], references: [id])
  service Service? @relation("ServiceWaitlist", fields: [serviceId], references: [id])
}

enum WaitlistStatus {
  PENDING
  NOTIFIED
  BOOKED
  CANCELLED
}

model Notification {
  id        Int                @id @default(autoincrement())
  userId    Int
  message   String
  type      NotificationType   @default(GENERAL)
  status    NotificationStatus @default(QUEUED)
  read      Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum NotificationType {
  GENERAL
  APPOINTMENT
  PAYMENT
  PROMOTION
  SYSTEM
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

model Report {
  id        Int      @id @default(autoincrement())
  title     String
  data      Json
  createdAt DateTime @default(now())
}
model Session {
  id        String    @id @default(cuid())
  userId    Int
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Second factor for ADMIN login. The code itself is never stored — only
// its hash — so a DB read alone can't be used to log in. `attempts` caps
// brute-force guesses against a single code; `consumedAt` prevents replay
// of an already-used code. One row per OTP sent (not one row per user)
// so a resend can't silently invalidate rate-limit history.
model LoginOtp {
  id         String    @id @default(cuid())
  userId     Int
  codeHash   String
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

